{
  "name": "telegram-videos-uploader",
  "version": "1.0.0",
  "description": "Telegram videos uploader made with Node.js and TypeScript.",
  "main": "./build/index.js",
  "scripts": {
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "migrate": "drizzle-kit migrate",
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "swc src -d build --strip-leading-paths --copy-files",
    "start": "node --env-file=.env ."
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "keywords": [],
  "author": "Nathan Murillo <nathanmurillodeoliveira@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@types/node": "^25.9.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@libsql/client": "^0.17.3",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "undici": "7.24.6",
    "zod": "^4.4.3"
  }
}
